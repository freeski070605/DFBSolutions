{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?route=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?route=robots"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/index?route=auth/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index?route=admin/:path*"
    },
    {
      "source": "/api/gallery/:path*",
      "destination": "/api/index?route=gallery/:path*"
    },
    {
      "source": "/api/content/:path*",
      "destination": "/api/index?route=content/:path*"
    },
    {
      "source": "/api/contact",
      "destination": "/api/index?route=contact"
    },
    {
      "source": "/api/contact-uploads",
      "destination": "/api/index?route=contact-uploads"
    },
    {
      "source": "/api/join-free-list",
      "destination": "/api/index?route=join-free-list"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
