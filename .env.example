# MongoDB Cloud / Atlas
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dfb_solutions

# Admin security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-characters

# Only needed for the first administrator setup. Remove it after setup succeeds.
ADMIN_SETUP_KEY=replace-with-a-long-one-time-random-key

# Optional email notifications. Inquiries are still stored in MongoDB without these.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Private client gallery / Cloudflare R2 (server-side only; never use VITE_ prefixes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dfb-client-galleries
R2_ENDPOINT=
GALLERY_CODE_PEPPER=
GALLERY_SESSION_SECRET=
